# Copiez ce fichier vers .env et renseignez uniquement les variables nécessaires.
# Ne versionnez jamais .env ni une clé privée réelle.

# Déploiement et vérification Sepolia (facultatif)
SEPOLIA_RPC_URL=https://sepolia.example.invalid/v3/your-project-id
SEPOLIA_PRIVATE_KEY=
ETHERSCAN_API_KEY=your_etherscan_api_key

# RPC public utilisé par le frontend pour les lectures Sepolia (facultatif en local)
VITE_SEPOLIA_RPC_URL=https://sepolia.example.invalid/v3/your-project-id

# Adresses publiques nécessaires uniquement au script de seed Sepolia
SEPOLIA_OWNER_1=
SEPOLIA_OWNER_2=
SEPOLIA_OWNER_3=

# Upload IPFS via le serveur local sécurisé (Pinata)
# Créez un JWT limité au téléversement dans votre compte Pinata ; ne le placez jamais dans frontend/.
PINATA_JWT=
# Optionnel : passerelle IPFS Pinata personnalisée pour l'affichage.
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
